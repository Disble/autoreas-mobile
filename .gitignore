# dependencies
node_modules/
package-lock.json

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# Jest
.jest/
coverage/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

app-example-src
resources/autoreas-data/*.dat
deprecated/

# Docker
.dockerignore

# Local EAS Android build artifacts
build-*.apk
build-*.aab
build-*/

# Machine-local agent skill registry (embeds absolute paths from the developer's home directory)
.atl/
# dlinter: mutation testing runtime artifacts
.dlinter-mutation-tmp/

#ignore
.ignore/

# MCP server config. Untracked on purpose: server definitions carry credentials
# in their `env` blocks (SONARQUBE_TOKEN and the like), and a tracked file is one
# absent-minded `git add` away from publishing one to a public repo.
.mcp.json
