{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "app/**/*.{ts,tsx}"
  ],
  "dynamicallyLoaded": [
    "plugins/withAndroidGradleMemory.js"
  ],
  "ignorePatterns": [
    "android/**",
    "ios/**",
    ".expo/**"
  ],
  "ignoreDependencies": [
    "expo-build-properties",
    "expo-web-browser",
    "@react-navigation/bottom-tabs",
    "@gorhom/bottom-sheet",
    "react-native-web",
    "expo-dev-client",
    "expo-system-ui",
    "expo-updates"
  ],
  "ignoreExports": [
    {
      "file": "src/**/index.ts",
      "exports": [
        "*"
      ]
    }
  ],
  "overrides": [
    {
      "files": [
        "src/**/index.ts"
      ],
      "rules": {
        "unused-types": "off"
      }
    }
  ],
  "duplicates": {
    "mode": "semantic",
    "threshold": 3,
    "minOccurrences": 3
  },
  "rules": {
    "boundary-violation": "error",
    "circular-dependencies": "error",
    "duplicate-exports": "error",
    "unlisted-dependencies": "error",
    "unresolved-imports": "error",
    "unused-dependencies": "error",
    "unused-files": "error",
    "unused-exports": "error",
    "unused-types": "error"
  }
}
