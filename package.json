{
  "name": "autoreas-mobile",
  "version": "v1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start -c",
    "android": "expo start --android -c",
    "ios": "expo start --ios -c",
    "web": "expo start --web -c",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "verify:architecture-boundary": "bun run lint && bun run typecheck",
    "validate": "bun run lint && bun run typecheck && bun run test",
    "doctor:react": "bunx react-doctor@0.5.1 . --verbose -y",
    "prepare": "lefthook install",
    "generate:feature": "node ./scripts/generate-feature.js",
    "verify:precommit-fail-path": "node ./scripts/verify-precommit-fail-path.mjs",
    "audit": "fallow audit --quiet"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@notifee/react-native": "^9.1.8",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@tanstack/react-query": "^5.96.2",
    "drizzle-orm": "^0.45.2",
    "expo": "~55.0.28",
    "expo-background-task": "~55.0.20",
    "expo-build-properties": "~55.0.16",
    "expo-camera": "~55.0.21",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.37",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.16",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.16",
    "expo-modules-core": "~55.0.25",
    "expo-network": "~55.0.16",
    "expo-router": "~55.0.17",
    "expo-splash-screen": "~55.0.23",
    "expo-sqlite": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.20",
    "expo-task-manager": "~55.0.18",
    "expo-updates": "~55.0.26",
    "expo-web-browser": "~55.0.18",
    "heroui-native": "^1.0.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.1.17",
    "uniwind": "^1.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "babel-plugin-inline-import": "^3.0.0",
    "dlinter-ts-react": "0.6.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.25.0",
