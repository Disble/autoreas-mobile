{
  "name": "autoreas-mobile",
  "version": "2.6.0",
  "license": "Apache-2.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start -c",
    "android": "expo start --android -c",
    "ios": "expo start --ios -c",
    "web": "expo start --web -c",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --maxWorkers=4",
    "test:watch": "jest --watch",
    "test:coverage": "jest --maxWorkers=4 --coverage",
    "verify:architecture-boundary": "bun run lint && bun run typecheck",
    "validate": "bun run lint && bun run typecheck && bun run test",
    "doctor:react": "bunx react-doctor@0.5.1 . --verbose -y",
    "generate:feature": "node ./scripts/generate-feature.js",
    "audit": "fallow audit --quiet",
    "test:mutation:staged": "node ./scripts/dlinter-mutation-staged.mjs",
    "test:mutation:core": "stryker run stryker.core.conf.js",
    "test:kotlin": "node ./scripts/kotlin-unit-tests.mjs",
    "sqlite:lab": "node --no-warnings ./tests/sqlite-lab/run.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/elements": "^2.9.45",
    "@react-navigation/native": "^7.5.1",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.20",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.16",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-modules-core": "~58.0.27",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.27",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "heroui-native": "^1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-notify-kit": "^10.9.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-plugin-inline-import": "^3.0.0",
    "dharness-eslint-plugin": "^0.4.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-doctor": "^0.9.18",
    "fallow": "^3.36.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "lefthook": "^2.2.2",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "trustedDependencies": [
    "lefthook"
  ],
  "reanimated": {
    "staticFeatureFlags": {
      "USE_COMMIT_HOOK_ONLY_FOR_REACT_COMMITS": true
    }
  }
}
