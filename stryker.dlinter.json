{
  "testRunner": "jest",
  "plugins": [
    "@stryker-mutator/jest-runner"
  ],
  "concurrency": 1,
  "disableTypeChecks": false,
  "ignoreStatic": true,
  "cleanTempDir": "always",
  "tempDirName": ".dlinter-mutation-tmp",
  "reporters": [
    "clear-text"
  ],
  "mutate": [
    "src/features/sync/native-foreground-sync-ticker.helpers.ts"
  ],
  "ignorePatterns": [
    ".codegraph",
    ".expo",
    ".jest",
    "coverage",
    "android",
    "ios",
    "node_modules"
  ],
  "thresholds": {
    "high": 80,
    "low": 80,
    "break": 80
  },
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true,
    "config": {
      "maxWorkers": 2
    }
  }
}
