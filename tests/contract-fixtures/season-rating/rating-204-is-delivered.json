{
  "name": "rating-204-is-delivered",
  "runtimes": [
    "js",
    "kotlin"
  ],
  "covers": [
    "R-5"
  ],
  "description": "A 204 delivers the rating, sent after the cycle's reconcile; its row becomes synced.",
  "given": {
    "cursor": 0,
    "animes": [],
    "outbox": [
      {
        "animeId": "anime-1",
        "operation": "season_rating",
        "payload": {
          "seasonId": "season-1",
          "grade": 8,
          "ratedAt": 1700000000000
        }
      }
    ]
  },
  "cycles": [
    {
      "bridge": [
        {
          "status": 202,
          "body": {
            "status": "ok",
            "applied_operations": [],
            "bridge_changes": [],
            "last_changelog_id": 0
          }
        },
        {
          "status": 204,
          "body": null
        }
      ],
      "attempt": "succeeded"
    }
  ],
  "expect": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/sync/reconcile",
        "lastChangelogId": 0,
        "operations": []
      },
      {
        "method": "POST",
        "path": "/api/seasons/active/ratings",
        "body": {
          "anime_id": "anime-1",
          "grade": 8,
          "rated_at": 1700000000000,
          "season_id": "season-1"
        }
      }
    ],
    "outbox": [
      {
        "animeId": "anime-1",
        "status": "synced",
        "unresolvedReason": null,
        "claimOwner": null,
        "conflictAttemptCount": 0
      }
    ]
  }
}
