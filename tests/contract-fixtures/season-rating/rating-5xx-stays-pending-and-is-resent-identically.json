{
  "name": "rating-5xx-stays-pending-and-is-resent-identically",
  "runtimes": [
    "js",
    "kotlin"
  ],
  "covers": [
    "R-4",
    "R-5"
  ],
  "description": "A 5xx keeps the rating pending without failing the attempt (I4); the next attempt re-sends the identical absolute rating, which the bridge accepts as a no-op repeat.",
  "given": {
    "cursor": 0,
    "animes": [],
    "outbox": [
      {
        "animeId": "anime-1",
        "operation": "season_rating",
        "payload": {
          "seasonId": "season-1",
          "grade": 8,
          "ratedAt": 1700000000000
        }
      }
    ]
  },
  "cycles": [
    {
      "bridge": [
        {
          "status": 202,
          "body": {
            "status": "ok",
            "applied_operations": [],
            "bridge_changes": [],
            "last_changelog_id": 0
          }
        },
        {
          "status": 503,
          "body": {
            "error": "down"
          }
        }
      ],
      "attempt": "succeeded"
    },
    {
      "bridge": [
        {
          "status": 202,
          "body": {
            "status": "ok",
            "applied_operations": [],
            "bridge_changes": [],
            "last_changelog_id": 0
          }
        },
        {
          "status": 204,
          "body": null
        }
      ],
      "attempt": "succeeded"
    }
  ],
  "expect": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/sync/reconcile",
        "lastChangelogId": 0,
        "operations": []
      },
      {
        "method": "POST",
        "path": "/api/seasons/active/ratings",
        "body": {
          "anime_id": "anime-1",
          "grade": 8,
          "rated_at": 1700000000000
        }
      },
      {
        "method": "POST",
        "path": "/api/sync/reconcile",
        "lastChangelogId": 0,
        "operations": []
      },
      {
        "method": "POST",
        "path": "/api/seasons/active/ratings",
        "body": {
          "anime_id": "anime-1",
          "grade": 8,
          "rated_at": 1700000000000
        }
      }
    ],
    "outbox": [
      {
        "animeId": "anime-1",
        "status": "synced",
        "unresolvedReason": null,
        "claimOwner": null,
        "conflictAttemptCount": 0
      }
    ]
  }
}
