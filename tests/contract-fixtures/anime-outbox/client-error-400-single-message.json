{
  "name": "client-error-400-single-message",
  "runtimes": [
    "js",
    "kotlin"
  ],
  "covers": [
    "R-5"
  ],
  "description": "400 on a request of one message: the message is rejected and becomes unresolved (dead_letter); it is sent once; the attempt fails.",
  "given": {
    "cursor": 0,
    "animes": [
      {
        "id": "anime-a",
        "token": 7
      }
    ],
    "outbox": [
      {
        "animeId": "anime-a",
        "payload": {
          "episodesWatched": 5
        }
      }
    ]
  },
  "cycles": [
    {
      "bridge": [
        {
          "status": 400,
          "body": {
            "error": "rejected"
          }
        }
      ],
      "attempt": "failed"
    }
  ],
  "expect": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/sync/reconcile",
        "lastChangelogId": 0,
        "operations": [
          {
            "anime_id": "anime-a",
            "operation": "update",
            "payload": {
              "episodesWatched": 5
            },
            "base": 7
          }
        ]
      }
    ],
    "outbox": [
      {
        "animeId": "anime-a",
        "status": "dead_letter",
        "unresolvedReason": null,
        "claimOwner": null,
        "conflictAttemptCount": 0
      }
    ],
    "cursor": 0,
    "tokens": {
      "anime-a": 7
    },
    "staged": []
  }
}
