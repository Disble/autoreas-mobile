{
  "name": "transport-failure-keeps-the-round-pending",
  "runtimes": [
    "js",
    "kotlin"
  ],
  "covers": [
    "R-5"
  ],
  "description": "Network error: the rows stay pending and released; the attempt fails; nothing is given up.",
  "given": {
    "cursor": 0,
    "animes": [
      {
        "id": "anime-a",
        "token": 7
      },
      {
        "id": "anime-b",
        "token": 7
      }
    ],
    "outbox": [
      {
        "animeId": "anime-a",
        "payload": {
          "episodesWatched": 5
        }
      },
      {
        "animeId": "anime-b",
        "payload": {
          "episodesWatched": 5
        }
      }
    ]
  },
  "cycles": [
    {
      "bridge": [
        {
          "transport": "refused"
        }
      ],
      "attempt": "failed"
    }
  ],
  "expect": {
    "requests": [],
    "outbox": [
      {
        "animeId": "anime-a",
        "status": "pending",
        "unresolvedReason": null,
        "claimOwner": null,
        "conflictAttemptCount": 0
      },
      {
        "animeId": "anime-b",
        "status": "pending",
        "unresolvedReason": null,
        "claimOwner": null,
        "conflictAttemptCount": 0
      }
    ],
    "cursor": 0,
    "tokens": {
      "anime-a": 7,
      "anime-b": 7
    },
    "staged": []
  }
}
