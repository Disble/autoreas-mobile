{
  "name": "identical-resend-after-a-5xx",
  "runtimes": [
    "js",
    "kotlin"
  ],
  "covers": [
    "R-4",
    "R-5"
  ],
  "description": "A 5xx leaves the round pending; the re-send in the next cycle carries identical operation fields (absolute payload, same base), so a bridge that applied the first one sees a no-op.",
  "given": {
    "cursor": 0,
    "animes": [
      {
        "id": "anime-a",
        "token": 7
      }
    ],
    "outbox": [
      {
        "animeId": "anime-a",
        "payload": {
          "episodesWatched": 5
        }
      }
    ]
  },
  "cycles": [
    {
      "bridge": [
        {
          "status": 503,
          "body": {
            "error": "rejected"
          }
        }
      ],
      "attempt": "failed"
    },
    {
      "bridge": [
        {
          "status": 202,
          "body": {
            "status": "accepted",
            "applied_operations": [
              {
                "anime_id": "anime-a",
                "operation": "update",
                "applied": true,
                "modified_at": 14
              }
            ],
            "bridge_changes": [],
            "last_changelog_id": 1
          }
        }
      ],
      "attempt": "succeeded"
    }
  ],
  "expect": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/sync/reconcile",
        "lastChangelogId": 0,
        "operations": [
          {
            "anime_id": "anime-a",
            "operation": "update",
            "payload": {
              "episodesWatched": 5
            },
            "base": 7
          }
        ]
      },
      {
        "method": "POST",
        "path": "/api/sync/reconcile",
        "lastChangelogId": 0,
        "operations": [
          {
            "anime_id": "anime-a",
            "operation": "update",
            "payload": {
              "episodesWatched": 5
            },
            "base": 7
          }
        ]
      }
    ],
    "outbox": [
      {
        "animeId": "anime-a",
        "status": "synced",
        "unresolvedReason": null,
        "claimOwner": null,
        "conflictAttemptCount": 0
      }
    ],
    "cursor": 1,
    "tokens": {
      "anime-a": 14
    },
    "staged": []
  }
}
