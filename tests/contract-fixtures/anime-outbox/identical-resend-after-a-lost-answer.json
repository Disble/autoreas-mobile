{
  "name": "identical-resend-after-a-lost-answer",
  "runtimes": [
    "js",
    "kotlin"
  ],
  "covers": [
    "R-4"
  ],
  "description": "The first send gets no answer (transport failure), so the row stays pending and the next cycle re-sends the SAME absolute event on the same base. The bridge treats the identical repeat as a no-op and confirms it; the device ends exactly as if the first send had been answered.",
  "given": {
    "cursor": 0,
    "animes": [
      {
        "id": "anime-a",
        "token": 7
      }
    ],
    "outbox": [
      {
        "animeId": "anime-a",
        "payload": {
          "episodesWatched": 5
        }
      }
    ]
  },
  "cycles": [
    {
      "bridge": [
        {
          "transport": "refused"
        }
      ],
      "attempt": "failed"
    },
    {
      "bridge": [
        {
          "status": 202,
          "body": {
            "status": "accepted",
            "applied_operations": [
              {
                "anime_id": "anime-a",
                "operation": "update",
                "applied": true,
                "modified_at": 14
              }
            ],
            "bridge_changes": [],
            "last_changelog_id": 1
          }
        }
      ],
      "attempt": "succeeded"
    }
  ],
  "expect": {
    "requests": [
      {
        "method": "POST",
        "path": "/api/sync/reconcile",
        "lastChangelogId": 0,
        "operations": [
          {
            "anime_id": "anime-a",
            "operation": "update",
            "payload": {
              "episodesWatched": 5
            },
            "base": 7
          }
        ]
      }
    ],
    "outbox": [
      {
        "animeId": "anime-a",
        "status": "synced",
        "unresolvedReason": null,
        "claimOwner": null,
        "conflictAttemptCount": 0
      }
    ],
    "cursor": 1,
    "tokens": {
      "anime-a": 14
    },
    "staged": []
  }
}
